@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    background-color: #f8fafc;
  }

  /* Visible focus rings for keyboard navigation */
  :focus-visible {
    outline: 2px solid #1b6b80;
    outline-offset: 2px;
    border-radius: 8px;
  }
}

@layer components {
  /* Cards */
  .card {
    @apply bg-white rounded-2xl border border-gray-100 shadow-card;
  }
  .card-hover {
    @apply card transition-all duration-200;
  }
  .card-hover:hover {
    @apply shadow-card-hover border-primary-200;
  }

  /* Buttons */
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold
           bg-primary-600 hover:bg-primary-700 text-white transition-colors duration-150 active:scale-[0.97]
           disabled:opacity-50 disabled:cursor-not-allowed shadow-btn cursor-pointer;
  }
  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold
           bg-gray-100 hover:bg-gray-200 text-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600
           dark:text-gray-200 transition-colors duration-150 cursor-pointer;
  }
  .btn-danger {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold
           bg-red-500 hover:bg-red-600 text-white transition-colors duration-150 active:scale-[0.97] cursor-pointer;
  }
  .btn-success {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold
           bg-emerald-500 hover:bg-emerald-600 text-white transition-colors duration-150 active:scale-[0.97] cursor-pointer;
  }
  .btn-outline {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold
           border-2 border-primary-600 text-primary-600 hover:bg-primary-50 transition-colors duration-150 cursor-pointer;
  }

  /* Form elements */
  .input {
    @apply w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
           bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm
           placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-500
           focus:border-transparent transition-shadow duration-150 shadow-sm;
  }
  .label {
    @apply block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5;
  }

  /* Badges */
  .badge { @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold; }
  .badge-success { @apply badge bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400; }
  .badge-warning { @apply badge bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400; }
  .badge-danger  { @apply badge bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400; }
  .badge-info    { @apply badge bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-400; }
  .badge-primary { @apply badge bg-primary-100 text-primary-700 dark:bg-primary-900/30 dark:text-primary-400; }
  .badge-gray    { @apply badge bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400; }

  /* Tables */
  .th { @apply px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider bg-gray-50 dark:bg-gray-800/60; }
  .td { @apply px-4 py-3.5 text-sm text-gray-700 dark:text-gray-300; }
  .tr-hover { @apply hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors; }

  /* Sidebar */
  .page-title { @apply text-2xl font-display font-bold text-gray-900 dark:text-white; }
  .sidebar-link {
    @apply flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium
           transition-colors duration-150 cursor-pointer w-full text-left;
  }
  .sidebar-active { @apply bg-primary-600 text-white shadow-sm; }
  .sidebar-inactive {
    @apply text-gray-600 dark:text-gray-400 hover:bg-primary-50 dark:hover:bg-gray-700/50
           hover:text-primary-700 dark:hover:text-white;
  }

  /* Section headers — used sparingly, not on every section */
  .section-tag {
    @apply inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold
           uppercase tracking-widest bg-primary-100 text-primary-700;
  }
}

/* Scrollbar */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
.dark ::-webkit-scrollbar-thumb { background: #475569; }

/* Animations */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-16px); }
  to   { opacity: 1; transform: translateX(0); }
}

.fade-up   { animation: fadeUp  .25s cubic-bezier(.25,.46,.45,.94) both; }
.fade-in   { animation: fadeIn  .2s  ease-out both; }
.slide-in  { animation: slideInLeft .25s cubic-bezier(.25,.46,.45,.94) both; }

/* Reduced motion: respect user preference */
@media (prefers-reduced-motion: reduce) {
  .fade-up,
  .fade-in,
  .slide-in {
    animation: none !important;
  }
  * {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Hero pattern overlay */
.hero-pattern {
  background-image:
    radial-gradient(circle at 20% 50%, rgba(27,107,128,0.2) 0%, transparent 60%),
    radial-gradient(circle at 80% 20%, rgba(45,122,94,0.15) 0%, transparent 60%),
    radial-gradient(circle at 60% 80%, rgba(106,90,205,0.1)  0%, transparent 60%);
}
